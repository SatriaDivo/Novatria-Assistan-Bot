# ==========================================
# Konfigurasi Inti Discord Bot
# ==========================================
TOKEN=ISI_TOKEN_BOT_DISCORD
CLIENT_ID=ISI_CLIENT_ID_BOT
GUILD_ID=ISI_GUILD_ID_SERVER_DISCORD

# ==========================================
# Channel ID Konfigurasi Server
# ==========================================
# Channel privat admin untuk remote control Hermes (/hermes)
ADMIN_CHANNEL_ID=ISI_CHANNEL_ID_HERMES_CONTROL

# Channel admin untuk kelola & log klaim bansos (/bansos add, log klaim)
BANSOS_LOG_CHANNEL_ID=ISI_CHANNEL_ID_BANSOS_MANAGE

# Channel publik selamat datang member baru
WELCOME_CHANNEL_ID=ISI_CHANNEL_ID_WELCOME

# Channel publik bansos (tempat drop panel klaim akun & API)
BANSOS_CHANNEL_ID=ISI_CHANNEL_ID_BAGI_AKUN

# ==========================================
# Role ID Konfigurasi Server
# ==========================================
# Role default otomatis saat member baru join
DEFAULT_ROLE_ID=ISI_ROLE_ID_MEMBER

# Role pilihan self-role
ROLE_BANSOS_ID=ISI_ROLE_ID_BANSOS_HUNTER
ROLE_GAMERS_ID=ISI_ROLE_ID_GAMERS

# Role admin (bisa lebih dari satu, pisahkan dengan koma)
ADMIN_ROLE_IDS=ISI_ROLE_ID_ADMIN

# ==========================================
# Integrasi Hermes di VPS
# ==========================================
# Nama systemd service atau binary Hermes di host VPS
HERMES_SERVICE_NAME=hermes
